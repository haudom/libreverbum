tools/en-de.sqlite3
*.sqlite3

# Nutzerprofil — persönliche Daten, gehören nie ins Repository
profil.sqlite3

# Testtexte und Testbücher (Project Gutenberg u. a.)
tools/*.txt
tools/*.epub

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Zwischenstände der Prüfwerkzeuge — siehe technik.md, Abschnitt 6.
# uv.lock gehört ausdrücklich **nicht** hierher: Sie hält die Messgrundlage fest.
.ruff_cache/
.mypy_cache/
.pytest_cache/
