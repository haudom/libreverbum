# Heruntergeladene Wörterbuchdaten — werden beim ersten Start bezogen,
# siehe technik.md, Abschnitt 2. Gehören nicht in die Versionsverwaltung.
tools/en-de.sqlite3
*.sqlite3

# Nutzerprofil — persönliche Daten, gehören nie ins Repository
profil.sqlite3

# Binäre Sicherungen beider Datenbanken (technik.md §4, „Sichern und Ausleiten").
*.sqlite3.backup

# Testtexte und Testbücher (Project Gutenberg u. a.)
tools/*.txt
tools/*.epub

# Datenverzeichnis des laufenden Programms (technik.md §9): config.toml, Wörterbuch
# und Profil. Das Profil ist der langfristige Wert des Programms und gehört nie ins
# Repository — es liegt hier nur, weil LibreVerbum aus dem Quellbaum läuft.
/data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Eigenes Werkzeug des Bearbeiters, kein Projektbestandteil.
claude-auto-resume.ps1

# Zwischenstand eines Subagenten — gehört zur Sitzung, nicht zum Projekt.
agent_status.json

# Zwischenstände der Prüfwerkzeuge — siehe technik.md, Abschnitt 6.
# uv.lock gehört ausdrücklich **nicht** hierher: Sie hält die Messgrundlage fest.
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Transportkopie der Claude-Erinnerungen — gehört zur Sitzung, nicht zum Projekt,
# genauso wie agent_status.json. Zurückspielen: claude-erinnerungen/LIESMICH.md.
/claude-erinnerungen/

# Renderings und Hilfsdatei des Gestaltungs-Mockups (technik.md §14). Sie entstehen
# reproduzierbar aus einem Befehl — tools/design_mockup/render_all.py —, und ein
# eingefrorener Satz Bilder veraltet mit dem ersten geänderten Token, ohne dass es
# jemandem auffällt. Die Zahlen dazu stehen in technik.md §14 und sind nachzurechnen,
# nicht nachzuschlagen.
tools/design_mockup/png/
tools/design_mockup/_live_shell.qml
